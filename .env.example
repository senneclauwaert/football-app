# Copy this file to .env and fill in the values before deploying.

# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=toekomstrelegem

# FastAPI
SECRET_KEY=change_me_64_char_random_hex
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Mollie (payments) — get from mollie.com dashboard
MOLLIE_API_KEY=live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your DuckDNS subdomain (no https://, no trailing slash)
# Used by docker-compose.prod.yml to inject VITE_API_URL at build time
DOMAIN=footballapprelegem.duckdns.org
